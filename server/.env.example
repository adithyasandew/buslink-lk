PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/buslink
CLIENT_ORIGIN=http://localhost:5173
# Generate a long random value locally; never commit the real .env
JWT_SECRET=change-me
# Enables the sandbox payment callback (POST /api/v1/payments/mock-gateway/callback); leave empty to disable
MOCK_GATEWAY_SECRET=
